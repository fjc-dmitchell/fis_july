                            <button action="fundControlNoticesDataGrid.editAction"/>
                            <button action="fundControlNoticesDataGrid.removeAction"/>
                        </hbox>
                        <dataGrid id="fundControlNoticesDataGrid" dataContainer="fundControlNoticesDc" width="100%"
                                  emptyStateText="No FCNs found" aggregatable="true" allRowsVisible="true">
                            <actions>
                                <action id="createAction" type="list_create">
                                    <properties>
                                        <property name="openMode" value="DIALOG"/>
                                        <property name="viewId" value="fis_FundControlNotice_dialog.detail"/>
                                    </properties>
                                </action>
                                <action id="editAction" type="list_edit">
                                    <properties>
                                        <property name="openMode" value="DIALOG"/>
                                        <property name="viewId" value="fis_FundControlNotice_dialog.detail"/>
                                    </properties>
                                </action>
                                <action id="removeAction" type="list_remove"/>
                            </actions>
                            <columns>
                                <column property="fcnDate" textAlign="END"/>
                                <column property="amount" textAlign="END">
                                    <numberRenderer numberFormat="#,##0.00"/>
                                    <aggregation type="SUM">
                                        <formatter>
                                            <number format="#,##0.00"/>
                                        </formatter>
                                    </aggregation>
                                </column>
                            </columns>
                        </dataGrid>
                    </details>
