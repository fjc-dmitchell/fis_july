            <div classNames="grid-panel">
                <vbox classNames="contrast-panel">
                    <!--                    <split>-->
                    <details opened="true" summaryText="Invoices" minWidth="100%">
                        <hbox id="buttonsPanel" classNames="buttons-panel">
                            <button action="invoicesDataGrid.createAction"/>
                            <button action="invoicesDataGrid.editAction"/>
                            <button action="invoicesDataGrid.removeAction"/>
                        </hbox>
                        <dataGrid id="invoicesDataGrid" dataContainer="invoicesDc"
                                  emptyStateText="No invoices found" aggregatable="true"
                                  allRowsVisible="true" minWidth="25rem">
                            <actions>
                                <action id="createAction" type="list_create">
                                    <properties>
                                        <property name="openMode" value="DIALOG"/>
                                        <property name="viewId" value="fis_Invoice_dialog.detail"/>
                                    </properties>
                                </action>
                                <action id="editAction" type="list_edit">
                                    <properties>
                                        <property name="openMode" value="DIALOG"/>
                                        <property name="viewId" value="fis_Invoice_dialog.detail"/>
                                    </properties>
                                </action>
                                <action id="removeAction" type="list_remove"/>
                            </actions>
                            <columns>
                                <column property="invoiceNumber" flexGrow="1"/>
                                <column property="invoiceDate" textAlign="END" width="130px" flexGrow="0"/>
                                <!--                                <column property="paymentDate" textAlign="END" width="130px" flexGrow="0"-->
                                header="Pay Date" key="paydate"/>
                                <column property="amount" textAlign="END" width="140px" flexGrow="0">
                                    <numberRenderer numberFormat="#,##0.00"/>
                                    <aggregation type="SUM">
                                        <formatter>
                                            <number format="#,##0.00"/>
                                        </formatter>
                                    </aggregation>
                                </column>
                            </columns>
                        </dataGrid>
                    </details>
                </vbox>
                <vbox classNames="contrast-panel">

                    <details opened="true" summaryText="Fund Control Notices" minWidth="100%">
                        <hbox id="fjnButtonsPanel" classNames="buttons-panel">
