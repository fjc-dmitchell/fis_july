<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://obligationDetailView.title"
      focusComponent="form">
    <data>
        <instance id="obligationDc"
                  class="gov.fjc.fis.entity.Obligation">
            <fetchPlan extends="_base">
                <property name="activity" fetchPlan="_base"/>
                <property name="objectClass" fetchPlan="_base">
                    <property name="titleAndCode"/>
                </property>
                <property name="invoices" fetchPlan="_base"/>
                <property name="fundControlNotices" fetchPlan="_base"/>
                <property name="attachments" fetchPlan="_base">
                    <property name="fileName"/>
                    <property name="formattedSize"/>
                    <property name="title"/>
                </property>
                <property name="statusString"/>
            </fetchPlan>
            <loader id="obligationDl"/>
            <collection id="invoicesDc" property="invoices"/>
            <collection id="fundControlNoticesDc" property="fundControlNotices"/>
            <collection id="attachmentsDc" property="attachments"/>
        </instance>
        <collection id="divisionsDc" class="gov.fjc.fis.entity.Division">
            <loader id="divisionsDl" readOnly="true"/>
        </collection>
        <collection id="categoriesDc" class="gov.fjc.fis.entity.Category">
            <loader id="categoriesDl" readOnly="true"/>
        </collection>
        <collection id="objectClassesDc" class="gov.fjc.fis.entity.ObjectClass">
            <loader id="objectClassesDl" readOnly="true"/>
        </collection>
        <collection id="activitiesDc" class="gov.fjc.fis.entity.Activity">
            <loader id="activitiesDl" readOnly="true"/>
        </collection>
    </data>
    <facets>
<!--        <dataLoadCoordinator auto="true"/>-->
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout expand="contentBox">
        <vbox id="contentBox" css="overflow: auto" padding="false">
            <vbox id="formWrapper" classNames="contrast-panel ">
                <formLayout id="form" dataContainer="obligationDc">
<!--                    <responsiveSteps>-->
<!--                        <responsiveStep minWidth="0" columns="1"/>-->
<!--                        <responsiveStep minWidth="40em" columns="2"/>-->
<!--                    </responsiveSteps>-->
                    <hbox colspan="2">
                        <textField id="budgetFiscalYearField" width="9em"
                                   label="Budget Fiscal Year" datatype="string" readOnly="true"/>
                        <entityComboBox id="divisionField" itemsContainer="divisionsDc"
                                        metaClass="fis_Division" label="Division" width="25em"/>
                    </hbox>
                    <hbox colspan="2">
                        <entityComboBox id="categoryField" itemsContainer="categoriesDc"
                                        metaClass="fis_Category" label="Category (MOC)" width="25em"/>
                        <entityComboBox id="budgetObjectClassField" itemsContainer="objectClassesDc"
                                        property="objectClass" label="Object Class (BOC)" width="25em"/>

                    </hbox>

                    <hbox colspan="2">
                        <entityComboBox id="activityField" itemsContainer="activitiesDc"
                                        property="activity" label="Activity" width="50em"/>
                    </hbox>


                    <textField id="documentNumberField" property="documentNumber"/>
                    <textField id="documentTypeField" property="documentType"/>
                    <textField id="lineNumberField" property="lineNumber"/>
                    <textField id="amountField" property="amount"/>
                    <datePicker id="documentDateField" property="documentDate"/>
                    <datePicker id="processDateField" property="processDate"/>
                    <checkbox id="aoSendField" property="aoSend"/>
                    <datePicker id="aoSyncDateField" property="aoSyncDate"/>
                    <textField id="vendorField" property="vendor"/>
                    <checkbox id="statusField" property="status"/>
                    <textField id="einField" property="ein"/>
                    <textField id="ein2Field" property="ein2"/>
                    <datePicker id="travelStartDateField" property="travelStartDate"/>
                    <datePicker id="travelEndDateField" property="travelEndDate"/>
                    <checkbox id="reconciledField" property="reconciled"/>
                    <checkbox id="blanketPurchaseOrderField" property="blanketPurchaseOrder"/>
                    <checkbox id="updatedField" property="updated"/>
                    <textField id="budgetOrgField" property="budgetOrg"/>
                    <textArea id="memoField" height="9.5em" property="memo"/>
                    <textField id="statusStringField" property="statusString"/>
                </formLayout>
            </vbox>
            <vbox classNames="contrast-panel">
                <hbox>
                    <vbox width="750px">
                        <h4 text="msg://gov.fjc.fis.entity/Obligation.invoices"/>
                        <hbox id="buttonsPanel" classNames="buttons-panel">
                            <button action="invoicesDataGrid.createAction"/>
                            <button action="invoicesDataGrid.editAction"/>
                            <button action="invoicesDataGrid.removeAction"/>
                        </hbox>
                        <dataGrid id="invoicesDataGrid" dataContainer="invoicesDc" width="100%" minHeight="18em"
                                  emptyStateText="No invoices found" aggregatable="true">
                            <actions>
                                <action id="createAction" type="list_create">
                                    <properties>
                                        <property name="openMode" value="DIALOG"/>
                                    </properties>
                                </action>
                                <action id="editAction" type="list_edit">
                                    <properties>
                                        <property name="openMode" value="DIALOG"/>
                                    </properties>
                                </action>
                                <action id="removeAction" type="list_remove"/>
                            </actions>
                            <columns>
                                <column property="invoiceNumber" width="290px"/>
                                <column property="invoiceDate" textAlign="END" width="140px"/>
                                <column property="paymentDate" textAlign="END" width="140px"/>
                                <column property="amount" textAlign="END" width="140px">
                                    <numberRenderer numberFormat="#,##0.00"/>
                                    <aggregation type="SUM">
                                        <formatter>
                                            <number format="#,##0.00"/>
                                        </formatter>
                                    </aggregation>
                                </column>
                            </columns>
                        </dataGrid>
                    </vbox>
                    <vbox width="450px">
                        <h4 text="msg://gov.fjc.fis.entity/Obligation.fundControlNotices"/>
                        <hbox id="fjnButtonsPanel" classNames="buttons-panel">
                            <button action="fundControlNoticesDataGrid.createAction"/>
                            <button action="fundControlNoticesDataGrid.editAction"/>
                            <button action="fundControlNoticesDataGrid.removeAction"/>
                        </hbox>
                        <dataGrid id="fundControlNoticesDataGrid" dataContainer="fundControlNoticesDc" width="100%"
                                  minHeight="8em" emptyStateText="No FCNs found" aggregatable="true">
                            <actions>
                                <action id="createAction" type="list_create">
                                    <properties>
                                        <property name="openMode" value="DIALOG"/>
                                    </properties>
                                </action>
                                <action id="editAction" type="list_edit">
                                    <properties>
                                        <property name="openMode" value="DIALOG"/>
                                    </properties>
                                </action>
                                <action id="removeAction" type="list_remove"/>
                            </actions>
                            <columns>
                                <column property="fcnDate" textAlign="END"/>
                                <column property="amount" textAlign="END">
                                    <numberRenderer numberFormat="#,##0.00"/>
                                    <aggregation type="SUM">
                                        <formatter>
                                            <number format="#,##0.00"/>
                                        </formatter>
                                    </aggregation>
                                </column>
                            </columns>
                        </dataGrid>
                    </vbox>
                </hbox>
            </vbox>
            <vbox>
                <h4 text="msg://gov.fjc.fis.entity/Obligation.attachments"/>
                <hbox id="fileButtonsPanel" classNames="buttons-panel">
                    <button action="attachmentsDataGrid.createAction"/>
                    <button action="attachmentsDataGrid.editAction"/>
                    <button action="attachmentsDataGrid.removeAction"/>
                </hbox>
                <dataGrid id="attachmentsDataGrid" dataContainer="attachmentsDc" width="100%" minHeight="20em"
                          emptyStateText="No file attachments found">
                    <actions>
                        <action id="createAction" type="list_create">
                            <properties>
                                <property name="openMode" value="DIALOG"/>
                            </properties>
                        </action>
                        <action id="editAction" type="list_edit">
                            <properties>
                                <property name="openMode" value="DIALOG"/>
                            </properties>
                        </action>
                        <action id="removeAction" type="list_remove"/>
                    </actions>
                    <columns>
                        <column property="fileReference"/>
                        <column property="contentLength"/>
                        <column property="fileName"/>
                        <column property="formattedSize"/>
                        <column property="title"/>
                    </columns>
                </dataGrid>
            </vbox>
        </vbox>
        <p id="createdByString"/>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
