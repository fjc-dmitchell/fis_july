<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://vendorDetailView.title"
      focusComponent="form">
    <data>
        <instance id="vendorDc"
                  class="gov.fjc.fis.entity.Vendor">
            <fetchPlan extends="_base"/>
            <loader id="vendorDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout alignItems="STRETCH"
            padding="false" spacing="false"
            expand="contentBox">
        <vbox id="contentBox" classNames="overflow-auto">
            <div classNames="grid-panel">
                <vbox classNames="contrast-panel">
                    <formLayout id="form" dataContainer="vendorDc">
                        <textField id="nameField" property="name"/>
                        <textField id="einField" property="ein"/>
                        <textField id="vendorCodeField" property="vendorCode"/>
                        <textField id="dunsField" property="duns"/>
                        <textField id="cageField" property="cage"/>
                        <formItem label="Status">
                            <checkbox id="activeField" property="active" label="Active"/>
                        </formItem>
                    </formLayout>
                </vbox>
                <vbox classNames="contrast-panel">
                    <formLayout id="addressForm" dataContainer="vendorDc">
                        <textField id="addressCodeField" property="addressCode"/>
                        <textField id="address1Field" property="address1"/>
                        <textField id="address2Field" property="address2"/>
                        <textField id="cityField" property="city"/>
                        <textField id="stateField" property="state"/>
                        <textField id="zipCodeField" property="zipCode"/>
                    </formLayout>
                </vbox>
            </div>
        </vbox>
        <vbox>
            <p id="createdByString"/>
        </vbox>
        <hbox id="detailActions" classNames="px-m py-s bg-contrast-5">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
