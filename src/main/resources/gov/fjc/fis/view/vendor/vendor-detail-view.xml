<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://vendorDetailView.title"
      focusComponent="form">
    <data>
        <instance id="vendorDc"
                  class="gov.fjc.fis.entity.Vendor">
            <fetchPlan extends="_base"/>
            <loader id="vendorDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="vendorDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1" labelsPosition="ASIDE"/>
                <responsiveStep minWidth="40em" columns="2" labelsPosition="ASIDE"/>
            </responsiveSteps>
            <formItem>
                <textField id="nameField" property="name"/>
            </formItem>
            <formItem>
                <textField id="einField" property="ein"/>
            </formItem>
            <formItem>
                <textField id="vendorCodeField" property="vendorCode"/>
            </formItem>
            <formItem>
                <textField id="addressCodeField" property="addressCode"/>
            </formItem>
            <formItem>
                <textField id="address1Field" property="address1"/>
            </formItem>
            <formItem>
                <textField id="address2Field" property="address2"/>
            </formItem>
            <formItem>
                <textField id="cityField" property="city"/>
            </formItem>
            <formItem>
                <textField id="stateField" property="state"/>
            </formItem>
            <formItem>
                <textField id="zipCodeField" property="zipCode"/>
            </formItem>
            <formItem>
                <textField id="dunsField" property="duns"/>
            </formItem>
            <formItem>
                <textField id="cageField" property="cage"/>
            </formItem>
        </formLayout>
        <checkbox id="activeField" property="active" label="Active" dataContainer="vendorDc"/>
        <p id="createdByString"/>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
