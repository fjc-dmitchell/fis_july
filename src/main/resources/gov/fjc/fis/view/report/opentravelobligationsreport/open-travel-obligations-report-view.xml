<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://openTravelObligationsReportView.title">
    <data>
        <collection id="appropriationsDc" class="gov.fjc.fis.entity.Appropriation">
            <loader id="appropriationsDl" readOnly="true"/>
        </collection>
        <collection id="divisionsDc" class="gov.fjc.fis.entity.Division">
            <loader id="divisionsDl" readOnly="true"/>
        </collection>
        <collection id="branchesDc" class="gov.fjc.fis.entity.Branch">
            <loader id="branchesDl" readOnly="true"/>
        </collection>
    </data>
    <layout>
        <vbox classNames="jmix-main-view-navigation bordered-panel" width="100%" spacing="false">
            <hbox>
            <entityComboBox id="bfySelectorField" itemsContainer="appropriationsDc" required="true"
                            metaClass="fis_Appropriation" label="Fiscal Year" width="8em"/>
                <checkbox id="obbbaField" label="Include OBBBA activities with matching CostOrg" alignSelf="END"/>
            </hbox>
            <multiSelectComboBoxPicker id="divisionSelectorField" itemsContainer="divisionsDc" title="Division"
                                       metaClass="fis_Division" label="Division" width="35em" required="true"
                                       autoExpand="VERTICAL" css="font-family: sans-serif;">
                         position="BOTTOM"/>
                <actions>
                    <action id="entity_clear" type="entity_clear" icon="vaadin:close-small"/>
                </actions>
            </multiSelectComboBoxPicker>
            <entityComboBox id="branchSelectorField" itemsContainer="branchesDc" title="Branch"
                            metaClass="fis_Branch" label="Branch" width="35em" visible="false">
                <actions>
                    <action id="entity_clear" type="entity_clear" icon="vaadin:close-small"/>
                </actions>
            </entityComboBox>
            <hbox>
                <datePicker id="beginDateField" label="Start date on or after" datatype="localDate"/>
                <datePicker id="endDateField" label="End date on or before" datatype="localDate"/>
                <checkbox id="allOpenField" label="All open travel" alignSelf="END"/>
            </hbox>
        </vbox>
        <hbox>
            <button id="cancelBtn" text="Cancel"/>
            <button id="executeBtn" text="Run Report" enabled="false"/>
        </hbox>
    </layout>
</view>