<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://positionListView.title"
      focusComponent="positionsDataGrid">
    <data>
        <collection id="positionsDc"
                    class="gov.fjc.fis.entity.personnel.Position">
            <fetchPlan extends="_base"/>
            <loader id="positionsDl" readOnly="true">
                <query>
                    <![CDATA[select e from fis_Position e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="positionsDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createBtn" action="positionsDataGrid.create"/>
            <button id="editBtn" action="positionsDataGrid.edit"/>
            <button id="excelExportBtn" action="positionsDataGrid.excelExport"/>
            <button id="removeBtn" action="positionsDataGrid.remove"/>
            <simplePagination id="pagination" dataLoader="positionsDl" autoLoad="true"
                              itemsPerPageDefaultValue="250"
                              itemsPerPageVisible="true" itemsPerPageItems="250,500,1000"/>
        </hbox>
        <dataGrid id="positionsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="positionsDc"
                  columnReorderingAllowed="true" themeNames="column-borders compact row-stripes" selectionMode="NONE">
            <actions>
                <action id="create" type="list_create"/>
                <action id="edit" type="list_edit"/>
                <action id="excelExport" type="grdexp_excelExport"/>
                <action id="remove" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="positionNbr" header="Position" width="100px"/>
                <column property="name" header="Employee Name" width="250px"/>
                <column property="jobtitle" header="Title" width="250px"/>
                <column property="status" width="90px" textAlign="CENTER"/>
                <column property="jlCostOrgCd" header="Division" width="120px"/>
                <column property="gvtComprate" textAlign="END" header="Basic" width="100px">
                    <numberRenderer numberFormat="#,##0"/>
                </column>
                <column property="gvtLocalityAdj" textAlign="END" header="Locality" width="100px">
                    <numberRenderer numberFormat="#,##0"/>
                </column>
                <column property="totalPay" textAlign="END" header="Total Pay" width="100px">
                    <numberRenderer numberFormat="#,##0"/>
                </column>
                <column property="grade" width="90px" textAlign="CENTER"/>
                <column property="stdHours" textAlign="END" header="Hours" width="100px"/>
                <column property="gvtWorkSched" header="Schedule" width="100px" textAlign="CENTER"/>
                <column property="regTemp" header="R/T" width="90px" textAlign="CENTER"/>
                <column property="fullPartTime" header="F/P" width="90px" textAlign="CENTER"/>
                <column property="emplType" header="Type" width="90px" textAlign="CENTER"/>
                <column property="gvtParNteDate" header="NTE" flexGrow="1" width="90px"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectBtn" action="selectAction"/>
            <button id="discardBtn" action="discardAction"/>
        </hbox>
    </layout>
</view>
